# true = simulated sensors + sample data (works with no backend)
VITE_USE_MOCK=true
VITE_API_BASE=/api
# MQTT topic the ESP32 publishes to, payload: {"pole":"P1","level_cm":5.1}
VITE_MQTT_TOPIC=bahagi/sensors/+/level
# HC-SR04 mounting height above tray floor (demo = 20 cm)
VITE_SENSOR_HEIGHT_CM=20
# demo = 1:10 tabletop gauge (2/5/9 cm). real = MMDA scale (20/48/94 cm)
VITE_SCALE=demo
# rain forecast provider: openmeteo (no key) | openweathermap
VITE_RAIN_PROVIDER=openmeteo
VITE_OWM_KEY=
# Messenger bot page username or ID (https://m.me/<this>)
VITE_MESSENGER_PAGE=
