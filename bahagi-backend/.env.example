# Copy this file to .env and fill in what you use. Everything has a working default.

# ---- decision rules
MIN_SOURCES=2               # independent signals needed for PHOTOS (2 photos, or photo + sensor/rain)
SENSOR_ALONE=1              # 1 = the pole sensor at knee level recommends a cut by itself
SUGGEST_NEIGHBORS=1         # 1 = after a street's cut, offer nearby streets with no report as an OPTIONAL cut
DANGER_LEVEL=knee           # act at this level or higher
REPORT_WINDOW_MIN=30        # photo reports older than this stop counting
CORROBORATE_M=150           # signals must be this close (m) to back each other up

# ---- flood model: per home, by ground elevation (data/feeder.json), not per street
DANGER_DEPTH_M=0.45         # water this deep at a home = cut it (about knee)
BUFFER_DEPTH_M=0.25         # safety buffer: also cut homes within 25 cm of danger (water may seep there)
WATCH_DEPTH_M=0.60          # SMS warning (power stays on) for homes within 60 cm of danger
FLOOD_REACH_M=200           # how far one reading or photo is trusted to describe

# ---- fake-photo checks
PHOTO_MAX_AGE_H=3           # EXIF says older than this = not counted
PHOTO_MAX_DIST_M=400        # photo/sender GPS this far from the street = not counted
TZ_OFFSET_H=8

# ---- water levels on the tabletop gauge (cm), same as the ESP32 and dashboard
GUTTER_CM=1
KNEE_CM=5
WAIST_CM=8
CHEST_CM=11

# ---- SMS: console (prints only) | semaphore | twilio | sns
SMS_PROVIDER=console
SMS_RADIUS_M=100            # around each affected home
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
AWS_REGION=ap-southeast-1

# ---- photo AI: manual (uses the level the resident picked) | bedrock
VISION_PROVIDER=manual
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0

# ---- rain forecast (Open-Meteo, free)
FORECAST_ENABLED=1
FORECAST_LAT=14.5995
FORECAST_LON=120.9842
HEAVY_RAIN_MM_H=7.5

# ---- web
CORS_ORIGINS=*
PUBLIC_URL=                 # e.g. http://192.168.1.10:8000 (used in photo links)

# ---- Messenger bot reports (read from the bot's Firebase; leave empty to switch off)
FIREBASE_DATABASE_URL=https://bahagi-f57d7-default-rtdb.asia-southeast1.firebasedatabase.app/
FIREBASE_POLL_S=4
